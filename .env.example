# Copy to .env and adjust. Credentials stay server-side; the browser never sees them.

# Optional: enables model-assisted synthesis (Claude Opus 5.5). Without it the
# app runs in extractive mode (verbatim OCBC excerpts + extracted values).
ANTHROPIC_API_KEY=
# RA_MODEL=claude-opus-5-5
# RA_MODEL_EFFORT=medium

# Ingestion window (calendar days ending today, Asia/Singapore). Any other value
# passed at run time is recorded and displayed as an explicit expansion.
RA_INGEST_WINDOW_DAYS=7
# Scheduled refresh (cron, SGT). Empty = disabled. Can also be set in the admin view.
RA_INGEST_SCHEDULE_CRON=
RA_INGEST_MIN_INTERVAL_S=1.0
RA_INGEST_MAX_RETRIES=3

# Storage location (default ./data)
# RA_DATA_DIR=

# Ports (defaults shown). All services bind to 127.0.0.1 only.
# RA_GATEWAY_PORT=8000
# RA_ORCHESTRATOR_PORT=8100
# RA_RESEARCH_PORT=8101
# RA_VALIDATOR_PORT=8102
# RA_DOCS_PORT=8103
# RA_INGESTION_PORT=8104

# Service tokens and the evidence-signing key are generated fresh by run.py on
# every launch; do not set them here.
